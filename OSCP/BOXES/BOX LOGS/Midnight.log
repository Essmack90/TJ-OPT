$processName = "RemoteNoteKeeper"

function Start-ProcessIfNotRunning {
    param(
        [string]$processName
    )

    $runningProcess = Get-Process -Name $processName -ErrorAction SilentlyContinue

    if (-not $runningProcess) {
        Write-Host "$processName is not running. Restarting..."
        Start-Process -FilePath "C:\Users\user\Desktop\RemoteNoteKeeper.exe" -ErrorAction SilentlyContinue
        Write-Host "Start process..."
    } else {
        Write-Host "$processName is running."
    }
}

